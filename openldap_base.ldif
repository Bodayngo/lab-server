# lab                            # dn: dc=lab
# └── bodayngo                   # dn: dc=bodayngo,dc=lab
#     ├── disable-users          # dn: ou=disabled-users,dc=bodayngo,dc=lab
#     ├── groups                 # dn: ou=groups,dc=bodayngo,dc=lab
#     │   └── employees          # dn: cn=employees,ou=groups,dc=bodayngo,dc=lab
#     │       ├── jane.doe       # *** membership defined by "employees" entry
#     │       └── john.doe       # *** membership defined by "employees" entry
#     └── users                  # dn: ou=users,dc=bodayngo,dc=lab
#         ├── dept1              # dn: ou=dept1,ou=users,dc=bodayngo,dc=lab
#         │   └── john.doe       # dn: uid=john.doe,ou=dept1,ou=users,dc=bodayngo,dc=lab
#         ├── dept2              # dn: ou=dept2,ou=users,dc=bodayngo,dc=lab
#         │   └── jane.doe       # dn: uid=jane.doe,ou=dept2,ou=users,dc=bodayngo,dc=lab
#         └── service.account    # dn: uid=service.account,ou=users,dc=bodayngo,dc=lab

#
# ORGANIZATIONAL UNITS
#
dn: ou=users,dc=bodayngo,dc=lab
objectClass: organizationalUnit
ou: users

dn: ou=groups,dc=bodayngo,dc=lab
objectClass: organizationalUnit
ou: groups

dn: ou=dept1,ou=users,dc=bodayngo,dc=lab
objectClass: organizationalUnit
ou: dept1

dn: ou=dept2,ou=users,dc=bodayngo,dc=lab
objectClass: organizationalUnit
ou: dept2

dn: ou=disabled-users,dc=bodayngo,dc=lab
objectClass: organizationalUnit
ou: disabled-users

#
# USERS
#
dn: uid=service.account,ou=users,dc=bodayngo,dc=lab
objectclass: top
objectclass: person
objectclass: organizationalPerson
objectclass: inetOrgPerson
uid: service.account
cn: Service
sn: Account
mail: service.account@bodayngo.lab
userPassword: password

dn: uid=john.doe,ou=dept1,ou=users,dc=bodayngo,dc=lab
objectclass: top
objectclass: person
objectclass: organizationalPerson
objectclass: inetOrgPerson
uid: john.doe
cn: John
sn: Doe
mail: john.doe@bodayngo.lab
userPassword: password

dn: uid=jane.doe,ou=dept2,ou=users,dc=bodayngo,dc=lab
objectclass: top
objectclass: person
objectclass: organizationalPerson
objectclass: inetOrgPerson
uid: jane.doe
cn: Jane
sn: Doe
mail: jane.doe@bodayngo.lab
userPassword: password

#
# GROUPS
#
dn: cn=employees,ou=groups,dc=bodayngo,dc=lab
objectclass: top
objectclass: groupOfNames
cn: employees
member: uid=john.doe,ou=dept1,ou=users,dc=bodayngo,dc=lab
member: uid=jane.doe,ou=dept2,ou=users,dc=bodayngo,dc=lab
